{
  "private": true,
  "name": "@pssbletrngle/werewolf",
  "scripts": {
    "dev": "turbo dev",
    "web": "turbo dev --filter=web...",
    "lint": "turbo lint",
    "test": "turbo test",
    "test:ci": "turbo test -- --run --coverage",
    "build": "turbo build",
    "clean": "turbo clean && rimraf node_modules",
    "check": "turbo check",
    "format": "biome format --write {src,scripts,tests}"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.3.4",
    "turbo": "^2.8.12"
  },
  "packageManager": "bun@1.3.14",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "resolutions": {
    "sharp": "0.35.1"
  }
}